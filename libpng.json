{
    "name": "libpng",
    "description": "PNG encoder and decoder",
    "filters":["rfpng","pngdec","encpng"],
    "help": "This filter encodes and decodes to PNG using libpng.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libpng.accessor",
    "filter_source":{
        "rfpng" : "reframe_png.c",
        "pngdec" : "dec_png.c",
        "encpng" : "enc_png.c"
    },
    "Format": ["PNG"],
    "using": ["solver_minimal_1"],
    "runtime": {
        "pngdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_RGB"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "royalty-free",
        "note": "PNG",
        "checked": "2026-10-16"
    }
}
